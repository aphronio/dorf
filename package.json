{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error check:agent check:gate check:keys check:web-types check:lint",
    "check:agent": "bun run --cwd apps/agent check",
    "check:gate": "bun run --cwd apps/gate check",
    "check:keys": "bun run --cwd apps/keys check",
    "check:web-types": "bun run --cwd apps/web typecheck",
    "proof": "bun run --cwd apps/agent proof",
    "check:lint": "oxlint apps images"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "oxlint": "1.90.0"
  }
}
