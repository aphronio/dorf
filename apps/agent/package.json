{
  "name": "@dorf/agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc",
    "proof": "bun run --parallel --no-exit-on-error proof:history proof:models proof:lifecycle proof:make-room proof:images",
    "proof:lifecycle": "node test/sandbox-lifecycle.ts",
    "proof:history": "node test/history.ts",
    "proof:models": "node test/models.ts",
    "proof:make-room": "node test/make-room.ts",
    "proof:images": "node test/images.ts",
    "proof:claude-plan": "node test/claude-plan.ts",
    "proof:substrate": "../../deploy/proof.sh substrate",
    "proof:repository": "../../deploy/proof.sh repository",
    "proof:upgrade": "KIND=1 ../../deploy/substrate.sh install v1.0.0-rc.3 && ../../deploy/up.sh && ../../deploy/proof.sh substrate-upgrade"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.7.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-env": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "ws": "8.21.0"
  }
}
