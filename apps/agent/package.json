{
  "name": "@dorf/agent",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc && tsc -p ../gate",
    "proof:lifecycle": "../../deploy/up.sh && node test/sandbox-lifecycle.ts",
    "proof:upgrade": "KIND=1 ../../deploy/substrate.sh install v1.0.0-rc.3 && ../../deploy/up.sh && node test/substrate-upgrade.ts",
    "proof:repository": "../../deploy/up.sh && node test/repository.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-env": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
